# App
APP_URL=http://localhost:3000                  # public URL of the web app
AUTH_MODE=anonymous                            # anonymous | full
ADMIN_EMAILS=you@example.com                   # comma-separated; verified accounts with these emails become admins on sign-in
BETTER_AUTH_SECRET=                            # random 32+ chars; required in production
DATABASE_URL=postgres://montage:montage@localhost:5432/montage
REDIS_URL=redis://localhost:6379
TRUSTED_PROXY_HOPS=1                           # proxies in front of the app that append to X-Forwarded-For (rate limits use this)

# Engine X (server-only)
ENGINEX_MODE=live                              # live | mock (tests and CI use mock)
ENGINEX_BASE_URL=https://enginex.run            # Engine X REST API (not enginex.fapi.run, which is its object store)
ENGINEX_API_KEY=                               # ek_live_... never expose to the client
ENGINEX_STORAGE_URL=https://enginex.fapi.run   # Engine X object store (MinIO); health page checks /minio/health/live
ENGINEX_ADMIN_KEY=                              # optional: Engine X admin key for `pnpm enginex:pipeline save/publish` only; never used by the app

# SMTP (sign-up and password-reset codes; required in production when AUTH_MODE=full)
# Without SMTP_HOST in development, codes are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                                      # SMTP_PASSWORD is accepted too
SMTP_FROM="MontageAI <no-reply@example.com>"

# Payments (later)
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
