{
  "name": "montageai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:secrets": "sh scripts/check-secrets.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env src/db/seed.mts",
    "enginex:smoke": "tsx --conditions=react-server --env-file-if-exists=.env scripts/enginex-smoke.mts",
    "worker:dev": "tsx watch --conditions=react-server --env-file-if-exists=.env src/worker/index.mts",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/index.mts",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env scripts/admin-create.mts",
    "catalog:sync": "tsx --conditions=react-server --env-file-if-exists=.env scripts/catalog-sync.mts",
    "enginex:pipeline": "tsx --env-file-if-exists=.env scripts/enginex-pipeline.mts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.6",
    "bullmq": "^6.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
