{
  "kind": "editor-api/pipeline",
  "formatVersion": 1,
  "source": {
    "id": "tpl_x4p9irJIKNb-",
    "version": 1
  },
  "name": "song-index",
  "description": "Song link -> audio file, duration, loudness every 0.05 s (the app measures the beat and drop from it), the lyrics as segments with every word force-aligned on the separated vocals, and where the voice is (voice activity). Cache per song; feeds every style-* pipeline.",
  "graph": {
    "version": 1,
    "nodes": [
      {
        "id": "music_url",
        "kind": "input",
        "name": "musicUrl",
        "type": "text",
        "sample": "https://www.youtube.com/watch?v=V-2ToWpNx9s",
        "required": true,
        "position": {
          "x": 0,
          "y": 75
        }
      },
      {
        "id": "music",
        "kind": "engine",
        "engine": "media-fetch",
        "operation": "audio",
        "params": {
          "tier": "cpu",
          "codec": "m4a",
          "retries": 5,
          "fragmentRetries": 10,
          "concurrentFragments": 8,
          "impersonate": "chrome"
        },
        "position": {
          "x": 380,
          "y": 75
        }
      },
      {
        "id": "music_file",
        "kind": "engine",
        "engine": "util",
        "operation": "pick",
        "params": {
          "index": 0
        },
        "position": {
          "x": 760,
          "y": 75
        }
      },
      {
        "id": "music_loudness",
        "kind": "engine",
        "engine": "video",
        "operation": "custom",
        "params": {
          "bin": "ffprobe",
          "tier": "cpu",
          "args": [
            "-v",
            "error",
            "-f",
            "lavfi",
            "-i",
            "amovie='{in0}',aresample=8000,asetnsamples=n=400:p=0,astats=metadata=1:reset=1",
            "-show_entries",
            "frame=pts_time:frame_tags=lavfi.astats.Overall.RMS_level",
            "-of",
            "csv=p=0"
          ]
        },
        "position": {
          "x": 1140,
          "y": 0
        }
      },
      {
        "id": "vocals",
        "kind": "engine",
        "engine": "transcribe",
        "operation": "separate",
        "params": {
          "model": "vocals",
          "stems": [
            "vocals"
          ],
          "format": "wav"
        },
        "position": {
          "x": 1140,
          "y": 150
        }
      },
      {
        "id": "transcript",
        "kind": "engine",
        "engine": "transcribe",
        "operation": "transcribe",
        "params": {
          "model": "large-v3",
          "language": "en",
          "align": false,
          "formats": [
            "json"
          ]
        },
        "position": {
          "x": 1520,
          "y": 0
        }
      },
      {
        "id": "aligned",
        "kind": "engine",
        "engine": "transcribe",
        "operation": "align",
        "params": {},
        "position": {
          "x": 1900,
          "y": 75
        }
      },
      {
        "id": "voice",
        "kind": "engine",
        "engine": "voice-activity",
        "operation": "segments",
        "params": {
          "threshold": 0.5,
          "minSpeechMs": 100,
          "minSilenceMs": 150,
          "paddingMs": 0
        },
        "position": {
          "x": 1520,
          "y": 150
        }
      },
      {
        "id": "out",
        "kind": "output",
        "fields": [
          "audio",
          "durationSec",
          "loudness",
          "segments",
          "voice",
          "title"
        ],
        "position": {
          "x": 2660,
          "y": 75
        }
      }
    ],
    "edges": [
      {
        "id": "music.files->music_file.list",
        "from": {
