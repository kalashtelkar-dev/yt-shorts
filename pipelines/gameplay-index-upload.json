  "name": "gameplay-index-upload",
  "description": "Gameplay upload + player name -> the video, its length, the player's kill times (1 fps kill-feed OCR, name-tolerant) and up to 5 intro-flex moments (no kill, >= 6 s from kills; picked by the vision model from 120 time-stamped frames). Cache per (video, player); feeds every style-* pipeline.",
  "graph": {
    "version": 1,
    "nodes": [
      {
        "id": "player_name",
        "kind": "input",
        "name": "playerName",
        "type": "text",
        "sample": "Me",
        "required": true,
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "stamp_font",
        "kind": "engine",
        "engine": "video",
        "params": {
          "args": [
            "-y",
            "-f",
            "data",
            "-i",
            "{in0}",
            "-map",
            "0",
            "-c",
            "copy",
            "-f",
            "data",
            "{out}"
          ],
          "tier": "gpu",
          "input": [
            "https://github.com/google/fonts/raw/main/ofl/notosans/NotoSans%5Bwdth%2Cwght%5D.ttf"
          ],
          "outputs": [
            {
              "name": "font.ttf",
