            "-an",
            "-c:v",
            "libx264",
            "-preset",
            "veryfast",
            "-crf",
            "18",
            "-pix_fmt",
            "yuv420p",
            "{out}"
          ],
          "tier": "gpu",
          "output": "killfeed.mp4"
        },
        "operation": "custom",
        "position": {
