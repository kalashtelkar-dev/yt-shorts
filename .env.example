# Copy to .env and fill in. Never commit .env; only this file (CLAUDE.md §11).

# ── App ──
APP_URL=http://localhost:3000             # public URL of the web app (links in emails, Google redirect, sitemap)
AUTH_MODE=full                            # full (accounts only, no guests) | anonymous (legacy)
ADMIN_EMAILS=you@example.com              # comma-separated; verified accounts with these emails become admins on sign-in
BETTER_AUTH_SECRET=                       # random 32+ characters; required in production
DATABASE_URL=postgres://montage:montage@localhost:5432/montage
REDIS_URL=redis://localhost:6379
TRUSTED_PROXY_HOPS=1                      # proxies in front of the app that append to X-Forwarded-For (rate limits use this)

# ── Engine X (server-only) ──
ENGINEX_MODE=live                         # live | mock (tests and CI use mock)
ENGINEX_BASE_URL=https://enginex.run      # REST API (not enginex-minio.minio.run, which is its object store)
ENGINEX_API_KEY=                          # ek_live_...; never expose to the client
ENGINEX_ADMIN_KEY=                        # optional; only for `npm run enginex:pipeline save/publish`, never used by the app
# Long-term storage for finished montages: set all three or none (without them, files go when Engine X clears them).
ENGINEX_STORE_PIPELINE=tpl_58P5rbAu2j3C   # the published store-file pipeline (pipelines/README.md)
ENGINEX_STORE_CONNECTION=Demo-Minio       # Engine X Object Storage connection (dashboard → Connections); must match pipelines/build.py
ENGINEX_STORE_BUCKET=montageai-media      # private bucket on that connection; must match pipelines/build.py

# ── Email (SMTP): sign-up and password-reset codes; required in production with AUTH_MODE=full ──
# Without SMTP_HOST in development, codes are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                                # SMTP_PASSWORD is accepted too
SMTP_FROM="MontageAI <no-reply@example.com>"

# ── Google sign-in (optional; AUTH_MODE=full only) ──
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application);
# authorized redirect URI: <APP_URL>/auth/google/callback. Leave both empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                     # server-only

# ── Payments ──
PAYMENTS_ENABLED=false                    # true shows "Add credits" and turns on checkout
PAYMENTS_PROVIDER=mock                    # mock (local testing only, refused in production) | cashfree
CASHFREE_ENV=sandbox                      # sandbox (test keys) | production (live keys)
CASHFREE_APP_ID=                          # Cashfree dashboard → Developers → API Keys: "App ID" (x-client-id)
CASHFREE_SECRET_KEY=                      # "Secret Key" (x-client-secret); also verifies webhooks. Server-only, never expose
